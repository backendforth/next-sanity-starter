{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-hint.mjs",
    "sync:prod-to-dev": "node --env-file-if-exists=.env scripts/sync-prod-to-dev.mjs",
    "mux:migrate-assets": "node --env-file-if-exists=.env scripts/mux-migrate-assets.mjs",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "SANITY_STUDIO_DEPLOYMENT_TARGET=production sanity deploy",
    "register": "node --env-file-if-exists=.env scripts/register-hosting.mjs",
    "generate": "sanity schema extract --enforce-required-fields --force",
    "lint": "pnpm --workspace-root exec biome check studio",
    "format": "pnpm --workspace-root exec biome check --write studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@repo/sanity-dataset-resolve": "workspace:*",
    "@repo/site-languages": "workspace:*",
    "@sanity/document-internationalization": "^6.2.38",
    "@sanity/icons": "^5.2.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2",
    "sanity": "^6.20.0",
    "sanity-plugin-internationalized-array": "^5.3.1",
    "sanity-plugin-media": "^6.3.1",
    "sanity-plugin-mux-input": "^5.0.12",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
