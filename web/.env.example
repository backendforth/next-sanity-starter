# Copy to `.env.local` for local Next.js (see https://nextjs.org/docs/app/building-your-application/configuring/environment-variables)

# Required — same Sanity project as `studio/.env`
SANITY_STUDIO_PROJECT_ID=

# Optional: public fallbacks if you read project id / dataset in Client Components
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=

# Dataset selection (aligned with `studio/.env`; resolved in `sanityEnv.ts` / `resolveStudioDataset.ts`):
# - Explicit `SANITY_STUDIO_DATASET` or `NEXT_PUBLIC_SANITY_DATASET` always wins.
# - Otherwise: `next dev` prefers development, then production; production build prefers production, then development.
#   Missing datasets are detected via Management API (if token below) or a lightweight HTTP probe on the Data API.
# SANITY_STUDIO_DATASET=
# SANITY_STUDIO_DATASET_DEVELOPMENT=development
# SANITY_STUDIO_DATASET_PRODUCTION=production
# Optional: list datasets via Sanity Management API (recommended if HTTP probes are blocked)
# SANITY_STUDIO_DATASET_RESOLVER_TOKEN=
# SANITY_AUTH_TOKEN=

# Live Preview / Visual Editing (Draft Mode, defineLive, Presentation iframe)
# Viewer token — server-only; used by draft-mode enable + sanityFetch for drafts. Create at sanity.io/manage → API → Tokens.
SANITY_API_READ_TOKEN=
# Presentation / live preview (iframe base URL; must match your Next.js app)
SANITY_STUDIO_PREVIEW_ORIGIN=

# Base URL of Sanity Studio (click-to-edit overlays). Default in code: http://localhost:3333
# NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333
