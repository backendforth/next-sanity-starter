import { ComposeIcon } from "@sanity/icons/Compose";
import { defineType } from "sanity";

export const __MODULE_VAR__ = defineType({
  name: "__MODULE_NAME__",
  title: "__MODULE_TITLE__",
  type: "object",
  icon: ComposeIcon,
  fields: [
    {
      name: "heading",
      title: "Heading",
      type: "string",
    },
  ],
  preview: {
    select: {
      heading: "heading",
    },
    prepare({ heading }) {
      return {
        title:
          typeof heading === "string" && heading.trim()
            ? heading
            : "__MODULE_TITLE__",
        subtitle: "__MODULE_TITLE__ module",
      };
    },
  },
});
