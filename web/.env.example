# Next.js web app — copy to `.env.local`. Variables marked BUILD are inlined when Next
# builds, so on a host they belong in the build environment and a change needs a redeploy.

# Required. Same project id as `studio/.env`. `next.config.ts` inlines it and the resolved
# dataset into every bundle, so server and client build identical image URLs.
SANITY_STUDIO_PROJECT_ID=

# Dataset (BUILD). Empty = auto-select (root README → "Datasets"). On Netlify, set it per
# site and deploy context (root README → "Dataset per site").
# SANITY_STUDIO_DATASET=
# Order while the dataset is empty: `production`, `development`, `preview`, or a dataset
# name tried first (e.g. `staging`). Set, it also decides whether the site counts as
# production for `robots.txt` and canonical URLs: only `production` does, even on a
# production host context. Unset, the host's production context decides.
# SANITY_STUDIO_DEPLOYMENT_TARGET=development
# Only if your datasets aren't named `development` / `production`.
# SANITY_STUDIO_DATASET_DEVELOPMENT=development
# SANITY_STUDIO_DATASET_PRODUCTION=production

# SECRET. Viewer token: Draft Mode, Presentation, and draft `siteLanguageSettings` in dev.
SANITY_API_READ_TOKEN=

# SECRET. Signs the Sanity webhook to `/api/revalidate`; the route refuses every request
# while it is unset. Without a webhook, content refreshes only while a visitor has the site
# open (`web/README.md` → "Freshness"). Leave it empty here: set, the site turns `SanityLive`
# off and waits for a webhook that never reaches localhost. On Netlify, Production context
# only (root README → "Revalidate webhook").
SANITY_REVALIDATE_SECRET=

# Studio URL (BUILD): click-to-edit links and CSP `frame-ancestors`. Default
# `http://localhost:3333`; `*.sanity.studio` is always allowed. In production, the
# Studio's `SANITY_STUDIO_HOSTING_URL`.
# NEXT_PUBLIC_SANITY_STUDIO_URL=https://studio.your-domain.tld

# Canonical origin (BUILD) for metadata, hreflang, sitemap and robots (`src/utils/siteUrl.ts`).
# Unset: http://localhost:3000 locally, the deploy host's own URL on Netlify / Vercel.
# NEXT_PUBLIC_SITE_URL=https://your-domain.tld

# Self-hosted analytics origins for the CSP (BUILD), comma-separated. The cloud hosts of
# the providers in Studio → Settings → Analytics & Tracking are already allowed.
# CSP_ANALYTICS_ORIGINS=https://analytics.example.com

# `false` makes the server skip the Sanity API CDN, `true` forces it. Default: CDN in
# production only.
# SANITY_USE_CDN=false
