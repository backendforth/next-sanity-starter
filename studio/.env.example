# Copy to `studio/.env`. Same project id as in `web/.env` / `web/.env.local`.

SANITY_STUDIO_PROJECT_ID=

# Optional: lock Studio to one dataset (skips auto-selection).
# SANITY_STUDIO_DATASET=production

# Auto-selection (@repo/sanity-dataset-resolve, `config/studioDataset.ts`):
# Locally: prefer dataset "development", else "production". Deploy / production hosting: prefer "production" first.
# Only datasets that exist in your Sanity project are used — if "development" does not exist, you get "production" without setting anything.
# Order tweaks: SANITY_STUDIO_DEPLOYMENT_TARGET=production | development | preview | <e.g. staging>
# Rename defaults: SANITY_STUDIO_DATASET_DEVELOPMENT / SANITY_STUDIO_DATASET_PRODUCTION
# Hosted Studio: literal `process.env.SANITY_*` in `studioDataset.ts` + Vite `import.meta.env.PROD` → production-first when the bundle has no deploy env.
SANITY_STUDIO_DATASET_DEVELOPMENT=development
SANITY_STUDIO_DATASET_PRODUCTION=production

# `pnpm run sync:prod-to-dev`: export from production name → import into development name

# Optional: list datasets via Management API (otherwise HTTP check / name order). `sanity login` sets SANITY_AUTH_TOKEN.
# SANITY_STUDIO_DATASET_RESOLVER_TOKEN=
# SANITY_AUTH_TOKEN=

# Presentation / preview iframe — your Next.js URL
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Optional: Mux (sanity-plugin-mux-input)
# SANITY_STUDIO_MUX_TOKEN_ID=
# SANITY_STUDIO_MUX_TOKEN_SECRET=
