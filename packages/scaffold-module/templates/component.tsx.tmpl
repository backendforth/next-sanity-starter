import type { ModuleOf } from "@/sanity/types";
import { plainText } from "@/sanity/utils/sanityLocalizedText";
import type { SiteLocaleConfig } from "@/src/i18n/fallbackSiteLocales";

import { moduleHeadingClassName, moduleSectionClassName } from "./moduleStyles";

// ─── Types ───────────────────────────────────────────────────────────────────

type Props = {
	/** Typed by TypeGen from the projection in `queries/components/modules/` — run `pnpm generate`. */
	module: ModuleOf<"__MODULE_NAME__">;
	/*
	 * The renderers pass both to every module (the scaffold wires them the same way on both
	 * branches). The fields are already in the document's language: read these only for hrefs
	 * (`resolveLinkMark`) or `uiLabel` texts, and leave them unused otherwise.
	 */
	locale: string;
	siteLocale: Pick<SiteLocaleConfig, "localeIds" | "defaultLocale">;
};

// ─── Component ───────────────────────────────────────────────────────────────

/**
 * `__MODULE_NAME__` — TODO: describe what this module renders.
 * Document-level i18n: fields are plain values (document is in one locale).
 */
export function __MODULE_COMPONENT__({ module }: Props) {
	const heading = plainText(module.heading);

	return (
		<section className={moduleSectionClassName}>
			{heading ? <h2 className={moduleHeadingClassName}>{heading}</h2> : null}
			{/* TODO: render the rest of the module data */}
		</section>
	);
}
