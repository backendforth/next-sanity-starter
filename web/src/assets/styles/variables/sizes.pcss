/* Layout + spacing — `--space-*`, content widths, `--container-spacing`; tiers via `theme(--breakpoint-*)`. */

:root {
  --nav-bar-height: rem(78);
  --footer-height: rem(624);

  --content-max-width: rem(1440);
  --content-min-width: rem(976);
  --container-spacing: rem(24);
  --container-gutter: calc(
    (var(--content-max-width) - var(--content-min-width)) / 2
  );

  --space-min: rem(2);
  --space-xs: rem(8);
  --space-sm: rem(16);
  --space-md: rem(32);
  --space-lg: rem(48);
  --space-xl: rem(64);
  --space-max: rem(96);
  --space-extra: rem(192);

  --radius-md: 0.375rem;
}

@media (width >= theme(--breakpoint-md)) {
  :root {
    --nav-bar-height: rem(114);
    --footer-height: rem(283);
    --container-spacing: rem(32);
    --content-max-width: rem(1536);
    --content-min-width: rem(1024);

    --space-min: rem(2);
    --space-xs: rem(9);
    --space-sm: rem(18);
    --space-md: rem(36);
    --space-lg: rem(54);
    --space-xl: rem(72);
    --space-max: rem(104);
    --space-extra: rem(216);
  }
}

@media (width >= theme(--breakpoint-2xl)) {
  :root {
    --nav-bar-height: rem(120);
    --footer-height: rem(300);
    --container-spacing: rem(40);
    --content-max-width: rem(1680);
    --content-min-width: rem(1120);

    --space-min: rem(2);
    --space-xs: rem(10);
    --space-sm: rem(20);
    --space-md: rem(40);
    --space-lg: rem(56);
    --space-xl: rem(80);
    --space-max: rem(112);
    --space-extra: rem(224);
  }
}

@media (width >= theme(--breakpoint-wide)) {
  :root {
    --nav-bar-height: rem(124);
    --footer-height: rem(320);
    --container-spacing: rem(48);
    --content-max-width: rem(1800);
    --content-min-width: rem(1200);

    --space-min: rem(2);
    --space-xs: rem(10);
    --space-sm: rem(20);
    --space-md: rem(40);
    --space-lg: rem(60);
    --space-xl: rem(88);
    --space-max: rem(120);
    --space-extra: rem(240);
  }
}
