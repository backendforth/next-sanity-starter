SANITY_STUDIO_PROJECT_ID=

# Optional: fixes the dataset for all environments (overrides automatic selection below).
# SANITY_STUDIO_DATASET=production

# Default dataset names used when SANITY_STUDIO_DATASET is unset:
# - NODE_ENV=development → prefer development, then production
# - production build → prefer production, then development
# SANITY_STUDIO_DATASET_DEVELOPMENT=development
# SANITY_STUDIO_DATASET_PRODUCTION=production

# Optional: list datasets via Management API and pick the first preferred name that exists.
# Uses SANITY_AUTH_TOKEN from `sanity login`, or set explicitly:
# SANITY_STUDIO_DATASET_RESOLVER_TOKEN=
# SANITY_AUTH_TOKEN=

# Presentation / live preview (iframe base URL; must match your Next.js app)
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Optional: Mux (sanity-plugin-mux-input)
# SANITY_STUDIO_MUX_TOKEN_ID=
# SANITY_STUDIO_MUX_TOKEN_SECRET=
