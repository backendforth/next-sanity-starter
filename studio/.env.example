# Copy to `studio/.env`. Same project id as in `web/.env` / `web/.env.local`.

SANITY_STUDIO_PROJECT_ID=

# Optional: lock Studio to one dataset (skips auto-selection).
# SANITY_STUDIO_DATASET=production

# Auto-selection (`@repo/sanity-dataset-resolve`; see `config/studioDataset.ts`):
# - Explicit SANITY_STUDIO_DATASET skips auto-selection.
# - Otherwise: order depends on host (Vercel/Netlify production vs local/preview), SANITY_STUDIO_DEPLOYMENT_TARGET, and hosted bundle (Vite `import.meta.env.PROD`). Locally: prefer "development" when it exists; production deploys: prefer "production". Only datasets that exist on the project are used — missing "development" falls back to "production" without extra config.
# - Order tweaks: SANITY_STUDIO_DEPLOYMENT_TARGET=production | development | preview | <e.g. staging>
# - Rename defaults (optional): SANITY_STUDIO_DATASET_DEVELOPMENT / SANITY_STUDIO_DATASET_PRODUCTION
# Hosted Studio: literal `process.env.SANITY_*` in `studioDataset.ts` (not a copied `process.env` object); when deploy env is empty, Vite `import.meta.env.PROD` → production-first in the bundle.
# SANITY_STUDIO_DEPLOYMENT_TARGET=production
# SANITY_STUDIO_DATASET_DEVELOPMENT=development
# SANITY_STUDIO_DATASET_PRODUCTION=production

# `pnpm run sync:prod-to-dev`: export from production name → import into development name

# Optional: list datasets via Management API (otherwise HTTP check / name order). `sanity login` sets SANITY_AUTH_TOKEN.
# SANITY_STUDIO_DATASET_RESOLVER_TOKEN=
# SANITY_AUTH_TOKEN=

# Presentation / preview iframe — must match the exact Next.js origin (scheme + host + port).
# Use the same host you type in the browser: `http://localhost:3000` vs `http://127.0.0.1:3000` are different origins.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Optional: comma-separated extra origins allowed for Presentation (e.g. production Next URL). Localhost is always allowed.
# SANITY_STUDIO_WEB_PREVIEW_ORIGINS=https://your-app.vercel.app

# Optional: Mux (sanity-plugin-mux-input)
# SANITY_STUDIO_MUX_TOKEN_ID=
# SANITY_STUDIO_MUX_TOKEN_SECRET=
