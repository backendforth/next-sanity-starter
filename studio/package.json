{
  "name": "studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-hint.mjs",
    "sync:prod-to-dev": "node scripts/sync-prod-to-dev.mjs",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "generate": "sanity schema extract --enforce-required-fields && sanity typegen generate",
    "lint": "pnpm --workspace-root exec biome check studio",
    "format": "pnpm --workspace-root exec biome format --write studio"
  },
  "dependencies": {
    "@repo/languages": "workspace:*",
    "@sanity/code-input": "^7.0.12",
    "@sanity/dashboard": "^5",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.2",
    "sanity": "^5.20.0",
    "sanity-plugin-internationalized-array": "^5.1.0",
    "sanity-plugin-media": "^4.1.1",
    "sanity-plugin-mux-input": "^2.17.0",
    "sanity-plugin-netlify": "^1.4.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
